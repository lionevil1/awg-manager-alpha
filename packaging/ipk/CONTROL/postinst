#!/bin/sh
set -e

chmod 0755 /opt/bin/awg-manager-alpha /opt/etc/init.d/S99awg-manager-alpha 2>/dev/null || true
chmod 0644 /opt/lib/modules/amneziawg.ko 2>/dev/null || true
mkdir -p /opt/var/run /opt/var/log /opt/lib/modules

if [ -z "$IPKG_INSTROOT" ]; then
    /opt/etc/init.d/S99awg-manager-alpha start >/dev/null 2>&1 || true
fi

exit 0
